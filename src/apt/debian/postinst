#!/bin/sh
set -e

import grp 2>/dev/null || true

VELUM_GROUP=$(id -Gn | tr ' ' '\n' | grep "^velum_.*_layer[0-9]*$" | sort -t_ -k3 -n | tail -1)

if [ -z "$VELUM_GROUP" ]; then
    echo "[velum-rec] Error: current user does not belong to any velum group."
    exit 1
fi

DEPARTMENT=$(echo "$VELUM_GROUP" | sed 's/^velum_//' | sed 's/_layer[0-9]*$//')
LAYER=$(echo "$VELUM_GROUP" | sed 's/.*_layer//')

INSTALL_DIR="/velum/$DEPARTMENT/layer$LAYER"

if [ ! -d "$INSTALL_DIR" ]; then
    echo "[velum-rec] Error: $INSTALL_DIR does not exist. Is the ABAC matrix initialized?"
    exit 1
fi

cp /usr/lib/velumrec/velumrec "$INSTALL_DIR/velumrec"
chmod 700 "$INSTALL_DIR/velumrec"

echo "[velum-rec] Installed to $INSTALL_DIR/velumrec"
echo "[velum-rec] Run '$INSTALL_DIR/velumrec --install' to initialize the recovery partition."
